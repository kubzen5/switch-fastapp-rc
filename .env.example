# Local development only. Fill passwords locally; never commit .env.
POSTGRES_DB=switch
POSTGRES_USER=switch
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=source.orders.v1
KAFKA_GROUP_ID=orders-materializer-v1
# Demo/replay: serialize consumers of this topic across all group IDs.
CONSUMER_EXCLUSIVE=false
API_PORT=8000
LOG_LEVEL=INFO
DEPENDENCY_TIMEOUT_SECONDS=60
SOURCE_NAME=snowflake.orders_source
SYNC_BATCH_SIZE=500
SYNC_INTERVAL_SECONDS=30
# Snowflake trial; password must be supplied locally.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SWITCH_DEMO
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_TABLE=ORDERS_SOURCE
# Use a role with the privileges described in README; optional if default role works.
SNOWFLAKE_ROLE=
# ACK timeout per attempt; full jitter exponential application retries.
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_PUBLISH_ATTEMPTS=4
KAFKA_RETRY_BASE_SECONDS=0.5
KAFKA_RETRY_MAX_SECONDS=5
KAFKA_SHUTDOWN_TIMEOUT_SECONDS=5
